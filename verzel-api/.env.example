PORT=3000
NODE_ENV=development

# Postgres local (npm run db:local sobe um Postgres embutido nesta URL).
# Em bancos que exigem SSL, adicione ?sslmode=require ao final da URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/verzel_leiloes

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173

# Segredos — gere com: npm run keygen
JWT_SECRET=
ALIAS_SECRET=
# Semente da chave Ed25519 que assina a cadeia de lances (64 hex ou qualquer texto longo)
SIGNING_KEY_SEED=

# Identificação enviada à API do Art Institute of Chicago
AIC_USER_AGENT=verzel-leiloes (seu-email@exemplo.com)
